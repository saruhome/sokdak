{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "private-beta": {
      "distribution": "internal",
      "channel": "private-beta",
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_RELEASE_STAGE": "private-beta"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_RELEASE_STAGE": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
