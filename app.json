{
  "expo": {
    "name": "SokDak",
    "slug": "sokdak",
    "version": "1.0.0",
    "scheme": "sokdak",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saruhome.sokdak",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "SokDak에서 말한 한국어 단어를 검색어로 바꾸기 위해 음성 인식이 필요합니다.",
        "NSMicrophoneUsageDescription": "SokDak에서 한국어 단어를 음성으로 검색하려면 마이크 접근이 필요합니다."
      }
    },
    "android": {
      "package": "com.saruhome.sokdak",
      "adaptiveIcon": {
        "backgroundColor": "#F6F2EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SokDak에서 한국어 단어를 음성으로 검색하려면 마이크 접근이 필요합니다.",
          "speechRecognitionPermission": "SokDak에서 말한 한국어 단어를 검색어로 바꾸기 위해 음성 인식이 필요합니다.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e6c42fd7-2538-423c-90f9-a0d5664cff1c"
      }
    },
    "owner": "saruhome"
  }
}
