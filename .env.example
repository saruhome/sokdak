EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# private-beta 또는 production. private-beta에서는 결제를 활성화하지 않습니다.
EXPO_PUBLIC_RELEASE_STAGE=private-beta

# production에서 필수인 공개 HTTPS 법률 문서 및 고객지원. example 도메인은 실제 운영 URL로 바꿔야 합니다.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://example.com/terms
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://example.com/delete-account
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
